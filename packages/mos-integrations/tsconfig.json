{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "references": [
    { "path": "../mos-contracts" },
    { "path": "../mos-capabilities" },
    { "path": "../mos-rights" }
  ],
  "include": ["src/**/*.ts"]
}
